# ---------- App ----------
APP_ENV=development
APP_NAME="AI Research Assistant"
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ---------- Database ----------
POSTGRES_USER=research_user
POSTGRES_PASSWORD=research_pass
POSTGRES_DB=research_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://research_user:research_pass@localhost:5432/research_assistant

# ---------- LLM Provider (pluggable, Groq is default) ----------
LLM_PROVIDER=groq                # groq | openai | anthropic
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3

GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Embeddings (for RAG) ----------
EMBEDDING_PROVIDER=huggingface   # huggingface | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------- Search Providers (pluggable, order = priority) ----------
SEARCH_PROVIDERS=arxiv,semantic_scholar
SEMANTIC_SCHOLAR_API_KEY=
MAX_PAPERS_PER_SOURCE=15

# ---------- LangSmith / observability (optional) ----------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=research-assistant
